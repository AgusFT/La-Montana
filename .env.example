# Credencial técnica de PostgreSQL. iniciar-local.sh genera un secreto local.
# No guardar .env en Git.
DEMO_DB_PASSWORD=
DEMO_FRONTEND_PORT=3200
DEMO_BACKEND_PORT=8280
DEMO_POSTGRES_PORT=55433
DEMO_MAILPIT_PORT=8225

# Remitente técnico; los mensajes de la demo se capturan en Mailpit local.
DEMO_SMTP_FROM=noreply@demo.lamontana.local

# Si queda vacía, se usa datos/demo/imagenes-web/entrada de este checkout.
# Para cambiarla, indicar una ruta absoluta y volver a ejecutar iniciar-local.sh.
# Se monta sólo para lectura. No indicar una carpeta de PDF privados.
DEMO_WEB_SOURCE_DIR=
