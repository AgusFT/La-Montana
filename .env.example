# Credencial técnica de PostgreSQL, no es una cuenta del programa.
# iniciar-local.sh genera un secreto local. No guardar .env en Git.
DB_PASSWORD=
# Token local aleatorio para crear al primer propietario. No es su contraseña.
SETUP_TOKEN=
FRONTEND_PORT=3000
BACKEND_PORT=8080
POSTGRES_PORT=5432
MAILPIT_PORT=8025

# Remitente técnico; los mensajes de la demo se capturan en Mailpit local.
SMTP_FROM=noreply@lamontana.local

# Carpeta de imágenes en el host: vacía usa datos/imagenes-web/entrada del proyecto.
# Para cambiarla, indicar una ruta absoluta y volver a ejecutar iniciar-local.sh.
# Se monta sólo para lectura. No indicar una carpeta de PDF privados.
WEB_SOURCE_DIR=
